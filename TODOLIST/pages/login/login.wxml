<!-- pages/login/login.wxml -->
<view class="page">
  <!-- Logo 和标语 -->
  <view class="brand-section">
    <view class="logo-container">
      <text class="logo-icon">⏳</text>
    </view>
    <text class="app-name">时光元</text>
    <text class="app-slogan">掌控时间，掌控人生</text>
  </view>

  <!-- 登录/注册切换 -->
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'login' ? 'active' : ''}}" bindtap="switchMode" data-mode="login">
      <text>登录</text>
    </view>
    <view class="mode-tab {{mode === 'register' ? 'active' : ''}}" bindtap="switchMode" data-mode="register">
      <text>注册</text>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <!-- 头像选择 -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image
        class="avatar-preview"
        src="{{avatarUrl || '/images/default-avatar.png'}}"
        mode="aspectFill"
      />
      <text class="avatar-hint">点击获取微信头像</text>
    </button>

    <!-- 昵称 -->
    <view class="input-group">
      <text class="input-label">昵称</text>
      <input
        type="nickname"
        class="input"
        value="{{nickName}}"
        placeholder="点击输入框获取微信昵称"
        bindblur="onNicknameBlur"
      />
    </view>

    <!-- 密码 -->
    <view class="input-group">
      <text class="input-label">密码</text>
      <view class="password-wrapper">
        <input
          type="{{showPassword ? 'text' : 'password'}}"
          class="input password-input"
          value="{{password}}"
          placeholder="请输入密码"
          bindinput="onPasswordInput"
        />
        <view class="pwd-toggle" bindtap="togglePasswordVisible">
          <text>{{showPassword ? '隐藏' : '显示'}}</text>
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <button class="login-btn btn-primary" bindtap="handleSubmit" loading="{{loading}}">
      <text wx:if="{{!loading}}">{{mode === 'login' ? '登录' : '注册'}}</text>
      <text wx:else>处理中...</text>
    </button>

    <!-- 模式切换 -->
    <view class="mode-switch" bindtap="switchMode">
      <text>{{mode === 'login' ? '没有账号？去注册' : '已有账号？去登录'}}</text>
    </view>

    <!-- 跳过登录 -->
    <view class="skip-link" bindtap="handleSkip">
      <text>跳过，先体验一下</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">登录即表示同意</text>
    <view class="footer-links">
      <text class="footer-link">《用户协议》</text>
      <text class="footer-text">和</text>
      <text class="footer-link">《隐私政策》</text>
    </view>
  </view>
</view>
