/* pages/login/login.wxss */

page {
  --lavender-dark: #7B5EA7;
  --lavender-mid: #9C7BC8;
  --lavender-light: #C9B4E9;
  --lavender-pale: #E8D5F5;
  --bg: #F5F0FF;
  background: var(--bg);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx 120rpx;
  box-sizing: border-box;
}

/* ── Brand 区域 ── */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.logo-container {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #C9B4E9 0%, #A78AC8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(124, 92, 180, 0.3);
  margin-bottom: 28rpx;
}

.logo-icon {
  font-size: 64rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--lavender-dark);
  letter-spacing: 8rpx;
  margin-bottom: 10rpx;
}

.app-slogan {
  font-size: 24rpx;
  color: #B0A0C8;
  letter-spacing: 4rpx;
}

/* ── 模式切换标签 ── */
.mode-tabs {
  display: flex;
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(124, 92, 180, 0.1);
}

.mode-tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #A0A0C0;
  transition: all 0.3s;
}

.mode-tab.active {
  background: linear-gradient(135deg, #C9B4E9 0%, #9C7BC8 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 180, 0.25);
}

/* ── 表单区域 ── */
.form-section {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

/* ── 头像选择 ── */
.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0 auto 8rpx;
  border-radius: 50%;
  background: transparent;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: visible;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--lavender-light);
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 180, 0.2);
}

.avatar-hint {
  display: block;
  font-size: 22rpx;
  color: #B0A0C8;
  margin-top: 12rpx;
  line-height: 1.4;
}

/* ── 输入框 ── */
.input-group {
  width: 100%;
}

.input-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #7B5EA7;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #D8C8F0;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333;
  background: #fff;
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--lavender-mid);
}

/* ── 密码输入框 ── */
.password-wrapper {
  position: relative;
  width: 100%;
}

.password-input {
  padding-right: 100rpx;
}

.pwd-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: var(--lavender-mid);
  line-height: 1;
}

/* ── 提交按钮 ── */
.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.login-btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #C9B4E9 0%, #9C7BC8 100%);
  color: #fff;
  box-shadow: 0 6rpx 24rpx rgba(124, 92, 180, 0.35);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ── 模式切换链接 ── */
.mode-switch {
  padding: 12rpx 20rpx;
}

.mode-switch text {
  font-size: 26rpx;
  color: var(--lavender-mid);
}

/* ── 跳过链接 ── */
.skip-link {
  padding: 8rpx 20rpx;
}

.skip-link text {
  font-size: 26rpx;
  color: #B0A0C8;
}

/* ── 底部 ── */
.footer {
  position: fixed;
  bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #C0B0D8;
}

.footer-links {
  display: flex;
  flex-direction: row;
  gap: 4rpx;
}

.footer-link {
  font-size: 22rpx;
  color: var(--lavender-mid);
}
